{
  "rules": {
    "users": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null && auth.uid === $userId",
        "profile": {
          ".validate": "newData.hasChildren(['name', 'email'])"
        }
      }
    },
    "devices": {
      ".read": true,
      ".write": true
    },
    "productProfiles": {
      ".read": true,
      ".write": true
    },
    "productThresholds": {
      ".read": true,
      ".write": true
    },
    "system": {
      ".read": true,
      ".write": true
    },
    "products": {
      ".read": true,
      ".write": true
    },
    "liveReadings": {
      ".read": true,
      ".write": true
    },
    "history": {
      ".read": true,
      ".write": true
    },
    "alerts": {
      ".read": true,
      ".write": true
    },
    "sensorData": {
      ".read": true,
      ".write": true
    }
  }
}
