{
  "rules": {
    "users": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null && auth.uid === $userId",
        "profile": {
          ".validate": "newData.hasChildren(['name', 'email'])"
        }
      }
    },
    "devices": {
      ".read": "auth != null",
      "$deviceId": {
        ".write": "auth != null"
      }
    },
    "products": {
      ".read": "auth != null",
      "$productId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['name', 'category', 'deviceId', 'batchId'])"
      }
    },
    "liveReadings": {
      ".read": "auth != null",
      "$productId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['temperature', 'humidity', 'gasLevel', 'timestamp'])"
      }
    },
    "history": {
      ".read": "auth != null",
      "$productId": {
        "$readingId": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['temperature', 'humidity', 'gasLevel', 'timestamp'])"
        }
      }
    },
    "alerts": {
      ".read": "auth != null",
      "$alertId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['productId', 'type', 'severity', 'resolved'])"
      }
    }
  }
}
